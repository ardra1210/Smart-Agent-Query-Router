# Copy to .env (used by docker compose) or export in your shell.

# keyword (default, no API key needed) or hybrid (keyword first, Claude when unsure)
ROUTER_STRATEGY=keyword

# Only used when ROUTER_STRATEGY=hybrid
ANTHROPIC_API_KEY=
ROUTER_LLM_MODEL=claude-opus-5-5

LOG_LEVEL=INFO

# Host port for docker compose
BACKEND_PORT=8000
